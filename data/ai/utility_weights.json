{
  "drift": {
    "note": "Superseded in v1.2: weights do not drift by counting behavior. Only Personality drifts, per the personality.drift rules above. The old weight-drift table is removed, not kept as an alternative."
  },
  "id": "utility_weights",
  "meanings": {
    "w_goal": "How close this action gets the entity to its current goal (e.g. a hunter's goal 'catch prey today' makes hunting score high).",
    "w_memory": "Whether memory pushes toward or away from this action (attacked by someone -> revenge / avoidance scores high; helped by someone -> helping them scores high).",
    "w_need": "How urgently this action relieves a need (hunger 90 -> eating scores near 1; hunger 10 -> eating scores low).",
    "w_personality": "How well this action matches the entity's Personality component (48 facets in 8 groups, see personality.facets). This is the root-cause term: behavior is the result, not the cause.",
    "w_reputation": "How this action affects reputation (helping a friendly faction scores high; offending one scores low).",
    "w_schedule": "Whether it is the right time for this action (working at the forge by day scores high; at midnight it scores low)."
  },
  "normalizations": {
    "goal": "1 if it advances the current Goal, 0.5 if unrelated, 0 if it contradicts the goal; 0.5 for all actions when there is no goal",
    "memory": "0.5 + push/pull: strength/200 added when memory pushes toward the action, subtracted when it pulls away; clamped 0..1; no relevant memory scores 0.5",
    "need": "most urgent need relieved by this action / 100; unrelated actions score 0",
    "personality": "action affinity value linearly normalized to 0..1 over the affinity range in data",
    "reputation": "0.5 + expected reputation delta / 40, clamped 0..1; unrelated actions score 0.5",
    "schedule": "1 if now is the scheduled time for this action, 0.5 if unrelated, 0 if wrong time"
  },
